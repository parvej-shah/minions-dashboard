// Minions AI Multi-Agent Cockpit Prisma Schema
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Multi-tenant SaaS models (Phase 1 draft, see
// /home/parvej/.claude/plans/make-the-full-plan-breezy-river.md).
//
// clientId on the pre-existing models below is intentionally nullable at this
// stage — the migration plan adds it additively first, backfills every
// existing row to a "tenant zero" Client representing getminions.ai, then
// flips the column to NOT NULL DEFAULT '<tenant-zero-id>' only once the
// backfill and n8n's PostgREST writes are both confirmed sending client_id.
// Do not make these NOT NULL until that backfill has run.
// ---------------------------------------------------------------------------

model Client {
  id                     String   @id @default(cuid())
  slug                   String   @unique // subdomain / URL segment, e.g. "acme-hvac"
  name                   String
  status                 String   @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | SUSPENDED | CANCELED
  timezone               String   @default("America/New_York")
  // Phase 6: the weekly question. pulseDay is 1 = Monday ... 7 = Sunday.
  pulseEnabled           Boolean  @default(true) @map("pulse_enabled")
  pulseDay               Int      @default(5) @map("pulse_day") @db.SmallInt
  // False until the user confirms the timezone (every tenant started on the default).
  timezoneConfirmed      Boolean  @default(false) @map("timezone_confirmed")
  // Maintainer-set manual usage-cap override (platform-admin dashboard), independent of
  // Subscription/Stripe -- NULL means "use the plan default". See findPlan()/plans.ts.
  assetsPerMonthOverride Int?     @map("assets_per_month_override")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  users           User[]
  brandProfile    BrandProfile?
  brandDirectives BrandDirective[]
  ideas           Idea[]
  assets          Asset[]
  blogs           Blog[]
  channels        ClientChannel[]
  toneExamples    ToneExample[]
  subscription    Subscription?
  usageEvents     UsageEvent[]
  pipelineRuns    PipelineRun[]
  memberships     ClientMembership[]
  postingSchedule PostingSchedule?
  ideaSources     IdeaSource[]
  icpProfile      IcpProfile?
  memories        ProfessionalMemory[]
  contentLanes    ContentLane[]
  weeklyPulses    WeeklyPulse[]

  @@map("clients")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  clientId  String?  @map("client_id") // the user's *active* workspace; null = platform staff or an invited member who hasn't accepted yet
  role      String   @default("MEMBER") // OWNER | MARKETING_DIRECTOR | MEMBER | SYSTEM_ADMIN -- role within the active (clientId) workspace
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  client      Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  memberships ClientMembership[]

  @@index([clientId])
  @@map("users")
}

/**
 * Every (user, client, role) a person belongs to — the record a "workspace
 * switcher" reads, distinct from `User.clientId`/`role` which are just
 * *which one is currently active*. Phase 1 gave every user exactly one
 * `clientId`; this is the minimal extension for one login managing several
 * clients (an agency) without widening `User` itself, so the common
 * single-tenant case (one row here per user) stays a simple lookup and only
 * agency accounts pay the extra join.
 * `userId` is nullable because an invite is written before the invitee has
 * ever signed in — keyed by `email` until then. `auth.ts`'s signIn callback
 * resolves it to a real `userId` (and sets `acceptedAt`) on their first
 * matching sign-in, mirroring the existing "unknown email rejected at
 * sign-in" rule with one exception: an email with a pending invite here is
 * let through.
 */
model ClientMembership {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  email      String // lowercase; the invite target before userId resolves, kept afterward for display
  clientId   String    @map("client_id")
  role       String    @default("MEMBER") // OWNER | MARKETING_DIRECTOR | MEMBER
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([email, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("client_memberships")
}

model ClientChannel {
  id            String   @id @default(cuid())
  clientId      String   @map("client_id")
  channelKey    String   @map("channel_key") // "blog" | "facebook" | "linkedin" | "x"
  isActive      Boolean  @default(false) @map("is_active")
  credentialRef String?  @map("credential_ref") // secrets-store reference; never a raw token here
  externalId    String?  @map("external_id") // e.g. FB Page ID, LinkedIn org URN
  config        Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, channelKey])
  @@map("client_channels")
}

/**
 * A feed the idea harvester pulls market signals from, per tenant.
 * Replaces the four RSS URLs that used to be hardcoded in 01_idea_harvester
 * (Hacker News, the n8n blog, TechCrunch AI, and a Google News query pinned
 * to "pest control HVAC plumbing") -- every tenant harvested the same four
 * feeds regardless of industry, which is a large part of why ideas repeated.
 * `kind` is RSS | GOOGLE_NEWS | REDDIT | SITEMAP; for GOOGLE_NEWS and REDDIT
 * the `url` is built from `query` at harvest time rather than stored, so a
 * tenant can type a topic instead of composing a feed URL.
 */
model IdeaSource {
  id            String    @id @default(cuid())
  clientId      String    @map("client_id")
  kind          String    @default("RSS")
  label         String
  url           String?
  query         String?
  // Harvest pulls at most this many items from this feed per run. Keeping it
  // per-source lets a tenant weight a high-signal feed above a noisy one.
  maxItems      Int       @default(5) @map("max_items")
  isActive      Boolean   @default(true) @map("is_active")
  // Set when a fetch fails, so the UI can show a broken feed instead of the
  // harvester silently returning fewer signals every run.
  lastError     String?   @map("last_error")
  lastFetchedAt DateTime? @map("last_fetched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isActive])
  @@map("idea_sources")
}

model ToneExample {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  content   String   @db.Text
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("tone_examples")
}

model Subscription {
  id                String    @id @default(cuid())
  clientId          String    @unique @map("client_id")
  stripeCustomerId  String    @unique @map("stripe_customer_id")
  stripeSubId       String?   @unique @map("stripe_sub_id")
  planKey           String    @map("plan_key") // e.g. "starter" | "growth" | "scale" — Stripe owns pricing
  status            String    @default("TRIALING") // mirrors Stripe subscription.status
  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageEvent {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  assetId   String?  @map("asset_id")
  eventType String   @map("event_type") // "LLM_CALL" | "IMAGE_GEN" | "PUBLISH"
  provider  String? // "dashscope", "cloudflare-r2", etc.
  model     String? // "qwen-plus" etc.
  costUsd   Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  quantity  Int      @default(1) // unit implied by eventType (tokens, images, publishes)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("usage_events")
}

model Idea {
  id                String    @id // e.g. "IDEA-0001"
  clientId          String?   @map("client_id") // nullable until Phase 1 backfill lands, see note above
  rawIdea           String    @map("raw_idea")
  angle             String?
  audience          String    @default("ICP")
  // Neutral defaults: these were tenant zero's trade and pillar, so any row
  // written without one silently became a home-services idea.
  targetTrade       String    @default("") @map("target_trade")
  // The rhetorical angle (The Myth, The Stakes, ...) the strategist keys its
  // hook off. WHAT the idea is about and why is laneId.
  pillar            String    @default("")
  source            String    @default("GOOGLE_TRENDS")
  sourceUrl         String?   @map("source_url")
  sourceTitle       String?   @map("source_title")
  signals           Json?     @default("[]")
  status            String    @default("HARVESTED")
  priority          String    @default("HIGH")
  geoMetro          String?   @map("geo_metro")
  why               String?
  icpRelevance      Int       @default(90) @map("icp_relevance")
  evidenceRequired  String?   @map("evidence_required")
  claimedByRunId    String?   @map("claimed_by_run_id")
  claimedAt         DateTime? @map("claimed_at")
  draftAssetId      String?   @map("draft_asset_id")
  rejectionReason   String?   @map("rejection_reason")
  scheduledFor      DateTime? @map("scheduled_for")
  queueOrder        Int?      @map("queue_order")
  tags              String[]  @default([])
  // "Steal like an artist": the structural lesson taken from the source
  // article -- how it opens, what evidence it leans on, how it closes --
  // never its wording. 02_idea_to_asset feeds this to the writer as craft
  // guidance, paired with a hard no-verbatim rule. See craftSourceUrl for
  // the piece it was learned from, which must be attributed if quoted.
  craftNotes        String?   @map("craft_notes") @db.Text
  craftSourceUrl    String?   @map("craft_source_url")
  // Normalized thesis used for semantic dedupe across runs -- lowercase,
  // stopworded, sorted keyword fingerprint of the idea's actual claim.
  thesisKey         String?   @map("thesis_key")
  // Thought-leadership flywheel metadata (docs/product/authority-flywheel-plan.md,
  // phase 3 writes these). sourceType: see SOURCE_TYPES in src/constants/sourceMix.ts.
  sourceType        String?   @map("source_type")
  icpProblem        String?   @map("icp_problem")
  readerContext     String?   @map("reader_context")
  authorAdvantage   String?   @map("author_advantage")
  whiteSpace        String?   @map("white_space")
  freshPerspective  String?   @map("fresh_perspective")
  vision            String?
  trustBasis        String[]  @default([]) @map("trust_basis")
  // ProfessionalMemory ids the idea rests on.
  memoryIds         String[]  @default([]) @map("memory_ids")
  laneId            String?   @map("lane_id")
  profileTarget     String?   @map("profile_target") // PERSONAL | COMPANY | BOTH
  recommendedFormat String?   @map("recommended_format") // POST | ARTICLE
  // Set by the code gate, never by the model: PASS | REJECT | BELOW_BAR.
  gateVerdict       String?   @map("gate_verdict")
  gateReasons       String[]  @default([]) @map("gate_reasons")
  scoreBreakdown    Json?     @map("score_breakdown")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lane   ContentLane? @relation(fields: [laneId], references: [id], onDelete: SetNull)
  assets Asset[]

  @@index([clientId])
  @@index([clientId, thesisKey])
  @@index([laneId], map: "ideas_lane_idx")
  @@map("ideas")
}

model Asset {
  id                  String    @id // e.g. "ASSET-0001"
  clientId            String?   @map("client_id") // nullable until Phase 1 backfill lands
  ideaId              String?   @map("idea_id")
  title               String
  slug                String    @unique
  hook                String?
  coreArgument        String?   @map("core_argument")
  content             String    @db.Text
  audience            String    @default("ICP")
  pillar              String    @default("")
  targetTrade         String?   @default("") @map("target_trade")
  status              String    @default("PENDING_REVIEW")
  claimsOk            String    @default("BLOCKED_PENDING_REVIEW") @map("claims_ok")
  // What the draft check found for a reviewer: invented figures, readability.
  reviewNotes         String[]  @default([]) @map("review_notes")
  // What the cover was drawn from (phase 5): layout, copy, score, notes.
  coverSpec           Json?     @map("cover_spec")
  heroImageUrl        String?   @map("hero_image_url")
  heroStatus          String    @default("READY") @map("hero_status")
  heroErrorCode       String?   @map("hero_error_code")
  heroProvider        String?   @map("hero_provider")
  heroAttempts        Int       @default(0) @map("hero_attempts")
  docUrl              String?   @map("doc_url")
  linkedinVariant     String?   @map("linkedin_variant") @db.Text
  facebookVariant     String?   @map("facebook_variant") @db.Text
  xVariant            String?   @map("x_variant") @db.Text
  version             Int       @default(1)
  generationCost      Decimal   @default(0.038) @map("generation_cost") @db.Decimal(10, 4)
  // Set while status is SCHEDULED: when the reviewer chose for it to go out (phase 7).
  scheduledFor        DateTime? @map("scheduled_for")
  publishedAt         DateTime? @map("published_at")
  publishedUrls       String?   @map("published_urls")
  facebookPostId      String?   @map("facebook_post_id")
  facebookPublishedAt DateTime? @map("facebook_published_at")
  linkedinPostId      String?   @map("linkedin_post_id")
  linkedinPublishedAt DateTime? @map("linkedin_published_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  claims Claim[]

  // One idea produces at most one asset. Postgres allows many NULLs under a
  // unique index, so assets with no idea are unaffected. This is the only layer
  // that binds n8n: `02_idea_to_asset` writes assets straight to PostgREST
  // (`POST /rest/v1/assets`), so an application check cannot stop it — a second
  // insert for the same idea has to fail at the database.
  @@unique([ideaId], map: "assets_idea_id_key")
  @@index([clientId])
  @@map("assets")
}

model Claim {
  id              String   @id // e.g. "CLM-0001"
  assetId         String   @map("asset_id")
  claimText       String   @map("claim_text")
  claimType       String   @default("ANECDOTE") @map("claim_type")
  source          String?
  verified        String   @default("N")
  confidenceScore Decimal? @default(0.95) @map("confidence_score") @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("claims")
}

model BrandProfile {
  // Was a hardcoded singleton (id defaulted to the literal "BRAND-MINIONS-01",
  // see the two remaining readers of that literal: src/constants/brand.ts:31
  // and src/services/brand.ts:7 BRAND_PROFILE_ID — both must move to a
  // clientId-keyed lookup, findUnique({where:{clientId}}), before this ships).
  id                        String   @id @default(cuid())
  clientId                  String?  @unique @map("client_id") // nullable until Phase 1 backfill lands
  brandName                 String   @default("getminions.ai") @map("brand_name")
  companyDomain             String   @default("getminions.ai") @map("company_domain")
  positioning               String   @db.Text
  primaryLogoUrl            String   @map("primary_logo_url")
  primaryInk                String   @map("primary_ink")
  brandTeal                 String   @map("brand_teal")
  brandCoral                String   @map("brand_coral")
  brandCream                String   @map("brand_cream")
  accentBlue                String   @map("accent_blue")
  // Covers (phase 5): the author line, and the logo or headshot copied into
  // R2 from primaryLogoUrl (coverPhotoSource), since imported URLs expire.
  coverByline               String?  @map("cover_byline")
  coverPhotoUrl             String?  @map("cover_photo_url")
  coverPhotoSource          String?  @map("cover_photo_source")
  // SHAPES | DOODLES | NONE: the illustration above a cover's headline (src/lib/covers/art.ts).
  coverArt                  String   @default("SHAPES") @map("cover_art")
  toneFormality             String   @default("tactile_operator") @map("tone_formality")
  toneCadence               String   @map("tone_cadence") @db.Text
  allowedProofClaims        String[] @default([]) @map("allowed_proof_claims")
  // Structured voice-test questionnaire (formality, sentence length, humor,
  // emoji use, signature phrases) — fixed-shape object per tenant, paired
  // with the raw pasted examples in ToneExample for few-shot grounding.
  toneQuestionnaire         Json?    @map("tone_questionnaire")
  // Tenant-configurable claims-gate control. Was a hardcoded universal rule
  // in 02_idea_to_asset's "Parse Claims and Gate" node (block all
  // CUSTOMER_RESULT claims, justified by "we have zero paying clients") —
  // other tenants WILL have real customer results to cite truthfully, so
  // this becomes a typed boolean the gate code reads, not prose fed to an LLM.
  allowCustomerResultClaims Boolean  @default(false) @map("allow_customer_result_claims")
  // How deep the AUTHOR is in this subject, set during onboarding.
  // EXPLORER     = newer to the field; cite sources, never claim experience.
  // PRACTITIONER = hands-on; may speak from their own projects (default).
  // AUTHORITY    = deep expertise; may make strong, definitive calls.
  // Read by /api/brand/context. Governs what a draft may claim as EVIDENCE
  // and how assertive it may be -- reading level is a separate axis and comes
  // from the audience/positioning directives.
  writerExpertise           String   @default("PRACTITIONER") @map("writer_expertise")
  // Harvest source mix override, e.g. {"CURRENT_WORK":35,...}; null = the
  // default in src/constants/sourceMix.ts.
  harvestSourceMix          Json?    @map("harvest_source_mix")
  visualAssets              Json?    @default("{}") @map("visual_assets")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("brand_profile")
}

model BrandDirective {
  id            String   @id // e.g. "DIR-001"
  clientId      String?  @map("client_id") // nullable until Phase 1 backfill lands
  category      String
  ruleKey       String   @map("rule_key")
  instruction   String   @db.Text
  priority      Int      @default(1)
  audienceScope String   @default("ALL") @map("audience_scope")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Cascade, not SetNull: a directive with clientId=null is unreachable
  // through every tenant-scoped query (Prisma's exact-match filter never
  // matches null), so SetNull just orphaned dead rows in the table forever
  // instead of removing them when a client was deleted -- found via a stray
  // NULL-client_id row (DIR-016) left behind by an already-deleted test tenant.
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("brand_directives")
}

model Blog {
  slug               String   @id
  clientId           String?  @map("client_id") // nullable until Phase 1 backfill lands
  title              String
  subtitle           String?
  hook               String?
  coreArgument       String?  @map("core_argument")
  content            String   @db.Text
  audience           String   @default("ICP")
  pillar             String   @default("")
  author             Json     @default("{\"name\": \"Minions.AI Team\", \"role\": \"Operations & AI Dispatch\"}")
  tags               String[] @default([])
  metaDescription    String?  @map("meta_description")
  readingTimeMinutes Int?     @default(3) @map("reading_time_minutes")
  assetId            String?  @map("asset_id")
  docUrl             String?  @map("doc_url")
  publishedAt        DateTime @default(now()) @map("published_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("blogs")
}

model PipelineRun {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  type      String
  status    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("pipeline_runs")
}

/// Real per-tenant posting cadence config, one row per Client. Distinct from
/// Idea.scheduledFor/queueOrder (a one-off manual per-idea override, unchanged
/// by this model) -- this drives the recurring "when should this tenant post
/// next" decision the 00b_posting_scheduler_dispatcher n8n workflow polls.
model PostingSchedule {
  id            String    @id @default(cuid())
  clientId      String    @unique @map("client_id")
  cadenceType   String    @default("EVERY_N_DAYS") @map("cadence_type") // "DAILY" | "EVERY_N_DAYS" | "DAYS_OF_WEEK"
  intervalDays  Int?      @map("interval_days") // required when cadenceType = EVERY_N_DAYS
  daysOfWeek    Int[]     @default([]) @map("days_of_week") // 0=Sun..6=Sat, required when cadenceType = DAYS_OF_WEEK
  postsPerDay   Int       @default(1) @map("posts_per_day")
  timesOfDay    String[]  @default(["09:00"]) @map("times_of_day") // "HH:mm", length == postsPerDay, interpreted in Client.timezone
  // Safe default: even a draft that passes the automated claims gate still
  // waits for a human's manual "Approve & Publish" click. Off restores the
  // pipeline's original always-auto-publish-on-claims-pass behavior. Never
  // affects claims-FAILING drafts -- those always require a human regardless.
  requireReview Boolean   @default(true) @map("require_review")
  isActive      Boolean   @default(true) @map("is_active") // lets a tenant pause the cadence without deleting config
  lastRunAt     DateTime? @map("last_run_at") // idempotency guard: the dispatcher won't refire the same due slot twice
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("posting_schedules")
}

/// Fixed-window request counter backing src/lib/rate-limit.ts. bucketKey is an
/// opaque string (a hash of a webhook secret, or a caller IP) -- never a raw
/// secret. No FK to Client: buckets can be per-secret or per-IP, not always
/// tenant-scoped.
model RateLimitHit {
  bucketKey   String   @map("bucket_key")
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@id([bucketKey, windowStart])
  @@map("rate_limit_hits")
}

/// The one ICP a tenant writes for (one per tenant, by decision D2). Kept
/// structured so prompts can name a specific pain or decision rather than
/// paraphrase a paragraph. Seeded from the tenant's AUDIENCE directives.
model IcpProfile {
  id             String   @id @default(cuid())
  clientId       String   @unique @map("client_id")
  who            String   @default("")
  role           String   @default("")
  companyType    String   @default("") @map("company_type")
  pains          String[] @default([])
  decisions      String[] @default([])
  questions      String[] @default([])
  buyingTriggers String[] @default([]) @map("buying_triggers")
  vocabulary     String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("icp_profiles")
}

/// What the author has actually lived: work, stories, lessons, opinions, and
/// the questions their ICP keeps asking. An idea must rest on one of these (or
/// on approved proof) to pass the authority gate. There is no PRIVATE
/// disclosure on purpose: confidential material is never stored (D4).
model ProfessionalMemory {
  id                    String    @id @default(cuid())
  clientId              String    @map("client_id")
  kind                  String // CURRENT_WORK | PAST_EXPERIENCE | OPINION | STORY | LESSON | ICP_QUESTION | EXPERIMENT | BUILD_IN_PUBLIC
  content               String    @db.Text
  disclosure            String    @default("PUBLIC") // PUBLIC | GENERALIZE
  source                String    @default("BRAND_PAGE") // BRAND_PAGE | WEEKLY_PULSE | IMPORT | EDIT_LEARNING
  // GENERALIZE items reach drafting prompts only as this lesson-only rewrite,
  // computed once per edit (keyed by a hash of the content it came from).
  generalizedContent    String?   @map("generalized_content") @db.Text
  generalizedSourceHash String?   @map("generalized_source_hash")
  usedCount             Int       @default(0) @map("used_count")
  lastUsedAt            DateTime? @map("last_used_at")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isActive], map: "professional_memories_client_active_idx")
  @@map("professional_memories")
}

/// The weekly question (phase 6): one row per tenant per week, keyed by that
/// week's Monday in the tenant's timezone. See src/lib/pulse.
model WeeklyPulse {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  weekStart    DateTime  @map("week_start") @db.Date
  status       String // SNOOZED | SKIPPED | EXTRACTED | ANSWERED
  snoozedUntil DateTime? @map("snoozed_until")
  answer       String?   @db.Text
  followups    Json      @default("{}")
  candidates   Json      @default("[]")
  memoryIds    String[]  @default([]) @map("memory_ids")
  answeredAt   DateTime? @map("answered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, weekStart])
  @@map("weekly_pulses")
}

/// WHAT a tenant publishes and why (an idea's pillar is only its rhetorical
/// angle). Weights drive the harvester's mix and, in phase 7, the scheduler.
model ContentLane {
  id            String   @id @default(cuid())
  clientId      String   @map("client_id")
  name          String
  purpose       String   @default("AUTHORITY") // AUTHORITY | CREDIBILITY | DEMAND
  brief         String   @default("")
  weight        Int      @default(1)
  profileTarget String   @default("PERSONAL") @map("profile_target") // PERSONAL | COMPANY | BOTH
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ideas  Idea[]

  @@unique([clientId, name])
  @@map("content_lanes")
}
