// Minions AI Multi-Agent Cockpit Prisma Schema
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AudienceLane {
  ICP
  PEER
  BRIDGE
}

model Idea {
  id               String       @id // e.g. "IDEA-0001"
  rawIdea          String       @map("raw_idea")
  angle            String?
  audience         String       @default("ICP")
  targetTrade      String       @default("HVAC") @map("target_trade")
  pillar           String       @default("Contractor Realities")
  source           String       @default("GOOGLE_TRENDS")
  status           String       @default("HARVESTED")
  priority         String       @default("HIGH")
  geoMetro         String?      @map("geo_metro")
  why              String?
  icpRelevance     Int          @default(90) @map("icp_relevance")
  evidenceRequired String?      @map("evidence_required")
  claimedByRunId   String?      @map("claimed_by_run_id")
  claimedAt        DateTime?    @map("claimed_at")
  draftAssetId     String?      @map("draft_asset_id")
  rejectionReason  String?      @map("rejection_reason")
  scheduledFor     DateTime?    @map("scheduled_for")
  queueOrder       Int?         @map("queue_order")
  tags             String[]     @default([])
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  assets           Asset[]

  @@map("ideas")
}

model Asset {
  id              String       @id // e.g. "ASSET-0001"
  ideaId          String?      @map("idea_id")
  title           String
  slug            String       @unique
  hook            String?
  coreArgument    String?      @map("core_argument")
  content         String       @db.Text
  audience        String       @default("ICP")
  pillar          String       @default("Contractor Realities")
  targetTrade     String?      @default("HVAC") @map("target_trade")
  status          String       @default("PENDING_REVIEW")
  claimsOk        String       @default("BLOCKED_PENDING_REVIEW") @map("claims_ok")
  heroImageUrl    String?      @map("hero_image_url")
  docUrl          String?      @map("doc_url")
  linkedinVariant String?      @map("linkedin_variant") @db.Text
  facebookVariant String?      @map("facebook_variant") @db.Text
  xVariant        String?      @map("x_variant") @db.Text
  version         Int          @default(1)
  generationCost  Decimal      @default(0.038) @map("generation_cost") @db.Decimal(10, 4)
  publishedAt     DateTime?    @map("published_at")
  publishedUrls   String?      @map("published_urls")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  idea            Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  claims          Claim[]

  @@map("assets")
}

model Claim {
  id              String   @id // e.g. "CLM-0001"
  assetId         String   @map("asset_id")
  claimText       String   @map("claim_text")
  claimType       String   @default("ANECDOTE") @map("claim_type")
  source          String?
  verified        String   @default("N")
  confidenceScore Decimal? @default(0.95) @map("confidence_score") @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("claims")
}

model BrandDirective {
  id            String   @id // e.g. "DIR-001"
  category      String
  ruleKey       String   @map("rule_key")
  instruction   String   @db.Text
  priority      Int      @default(1)
  audienceScope String   @default("ALL") @map("audience_scope")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("brand_directives")
}

model Blog {
  slug               String   @id
  title              String
  subtitle           String?
  hook               String?
  coreArgument       String?  @map("core_argument")
  content            String   @db.Text
  audience           String   @default("ICP")
  pillar             String   @default("Contractor Realities")
  author             Json     @default("{\"name\": \"Minions.AI Team\", \"role\": \"Operations & AI Dispatch\"}")
  tags               String[] @default(["Contractors", "AI Dispatch"])
  metaDescription    String?  @map("meta_description")
  readingTimeMinutes Int?     @default(3) @map("reading_time_minutes")
  assetId            String?  @map("asset_id")
  docUrl             String?  @map("doc_url")
  publishedAt        DateTime @default(now()) @map("published_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("blogs")
}
